# syntax=docker/dockerfile:1
# Build de producao: compila o frontend e serve os assets estaticos via Nginx.
# Contexto de build esperado: raiz do repositorio (necessario para alcancar ./frontend).

FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY frontend/package.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install
# Corrige o bit de execucao de node_modules/.bin/* — builds rootless (ex.: OpenShift/Buildah)
# podem perder essa permissao na extracao dos pacotes; no-op em builds normais do Docker.
RUN chmod -R +x node_modules/.bin
COPY frontend/ .
# Vite embute VITE_* no bundle estatico durante o build (nao em runtime) —
# precisam ser passados como build arg (--build-arg), nao como env do container.
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_GRAFANA_URL=""
ARG VITE_ZABBIX_URL=""
ARG VITE_HEADLAMP_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GRAFANA_URL=$VITE_GRAFANA_URL
ENV VITE_ZABBIX_URL=$VITE_ZABBIX_URL
ENV VITE_HEADLAMP_URL=$VITE_HEADLAMP_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY infra/nginx/conf.d/default.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/dist /usr/share/nginx/html
