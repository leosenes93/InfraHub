# =============================================================================
# InfraHub — Variáveis de ambiente centralizadas
# Copie este arquivo para ".env" e ajuste os valores antes de subir o ambiente.
# =============================================================================

# --- Geral ---
ENVIRONMENT=development
PROJECT_NAME=InfraHub
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=infrahub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infrahub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://infrahub:change-me@postgres:5432/infrahub

# --- Cache (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Autenticação (JWT) ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Usuário administrador inicial (seed automático no primeiro start) ---
INITIAL_ADMIN_EMAIL=admin@infrahub.io
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_FULL_NAME=Administrador InfraHub

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
VITE_GRAFANA_URL=http://localhost:3000

# --- Portas expostas no host ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080
POSTGRES_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6379

# --- Observabilidade e administração (docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8081
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
PORTAINER_PORT=9000
UPTIME_KUMA_PORT=3001

# --- Zabbix (docker-compose.zabbix.yml) ---
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=change-me
ZABBIX_DB_NAME=zabbix
ZABBIX_WEB_PORT=8082
ZABBIX_SERVER_PORT=10051
# URL interna da API (rede Docker) — normalmente não precisa mudar.
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
# Gerado após o primeiro login na UI do Zabbix (ver docs/zabbix.md).
# Vazio = integração Zabbix desligada (endpoints retornam "não configurado").
ZABBIX_API_TOKEN=